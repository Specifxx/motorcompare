# All optional. Set in Vercel (build-time) unless noted.
NEXT_PUBLIC_SITE_URL=https://motorcompare.vercel.app
# Search Console HTML-tag verification (content value only)
GOOGLE_SITE_VERIFICATION=
# (eBay Partner Network: campaign 5339155912 is hard-coded in src/lib/affiliate.ts; no variable.
#  Amazon Associates tags are hard-coded too: AU motorcompare-22, the rest the family's.)
# Fragrance retailer tracking-link templates ({q} = encoded query, {url} = encoded search URL,
# {sub} = our sc-<region>-<placement>-<ean> tag). A retailer's row shows only once set
# (FragranceX and FragranceNet show as plain searches until then).
AFF_FRAGRANCEX=
AFF_FRAGRANCENET=
AFF_PERFUMANIA=
AFF_SEPHORA=
AFF_SEPHORA_AU=
AFF_NOTINO_UK=
AFF_NOTINO_EU=
AFF_SCENTSTORE=
AFF_LOOKFANTASTIC=
AFF_CULTBEAUTY=
AFF_PARFUMDREAMS=
AFF_SOBELIA=
AFF_ADOREBEAUTY=
AFF_YESSTYLE=
# Reviews and visitor reports: a fine-grained GitHub token with contents: write on this repo (Vercel, runtime)
REVIEWS_GITHUB_TOKEN=
REPORTS_GITHUB_TOKEN=
# IndexNow key (also a GitHub secret for the daily ping)
INDEXNOW_KEY=
# eBay Marketplace Account Deletion verification token (Vercel, runtime)
EBAY_VERIFICATION_TOKEN=
# GitHub Actions secrets only (never Vercel): MotorCompare's own eBay Browse API keys, and the
# repository variable EBAY_DAILY_CAP (default and maximum 2,500)
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Local development against the fixture instead of data/public:
# SC_DATA_DIR=tests/fixtures/data
